{
  "expo": {
    "name": "Astor Kayıt",
    "slug": "astor-kayit",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "astorkayit"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotoğraf ve video çekebilmek için kamera izni gereklidir.",
        "NSMicrophoneUsageDescription": "Video kaydederken ses kaydı yapabilmek için mikrofon izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "Galerinizden fotoğraf ve video seçebilmeniz için galeri erişim izni gereklidir."
      }
    },
    "android": {
      "package": "tr.net.burakaydogan.astorkayit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ic_launcher_foreground.png",
        "backgroundImage": "./assets/images/ic_launcher_background.png",
        "monochromeImage": "./assets/images/ic_launcher_monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashscreen_image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fotoğraf ve video çekebilmek için kamera izni gereklidir.",
          "microphonePermission": "Video kaydederken ses kaydı yapabilmek için mikrofon izni gereklidir.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerinizden fotoğraf ve video seçebilmeniz için galeri erişim izni gereklidir.",
          "cameraPermission": "Fotoğraf çekebilmeniz için kamera izni gereklidir."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "./scripts/withSplitApk.js",
      "./scripts/withGradleJvmArgs.js",
      "./scripts/withCustomApkName.js",
      "./scripts/withFileProvider.js",
      "./scripts/withBuildOptimizations.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b6e4a0b-d4ae-4225-8cdd-0d67c1a8c2f2"
      },
      "variant": "production",
      "apiUrl": "https://api.example.com"
    },
    "owner": "darkpuye"
  }
}
